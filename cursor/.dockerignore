# .dockerignore — exclude local-state dirs from build context.
# context/.cursor/ is populated by prepare.ps1 and IS needed in the build
# context. Only host-side runtime state is excluded here.

# Exclude saved image artifacts that landed in the subdir
*.tar
cursor-custom
*-custom

# Exclude editor/IDE noise
.vscode/
.idea/
*.swp
*~

# Exclude git metadata (not needed in image layers)
.git/
