# Build context — ephemeral, generated by prepare.ps1 from host config.
# NEVER commit these. Personal plugin cache, hooks, and settings live here.
claude/context/.claude/
codex/context/.codex/
opencode/context/.config/

# Build artifacts produced by build.ps1; not part of the repo.
*.tar
claude/cc-custom
claude/*-custom
codex/codex-custom
codex/*-custom
opencode/opencode-custom
opencode/*-custom
.probe
.claude
.projex
