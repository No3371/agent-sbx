codex/*-custom
opencode/opencode-custom
opencode/*-custom
cursor/cursor-custom
cursor/*-custom
pi/pi-custom
pi/*-custom
.probe
.claude
.codegraph
opencode/.opencode
omp/context
omp/sbx-omp
opencode/context
pi/context
pi/.pi/sessions
pi/.pi
