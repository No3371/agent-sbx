# .dockerignore — exclude local-state dirs from build context.
# context/.claude/ and context/.codex/ are populated by prepare.ps1 and ARE
# needed in the build context. Only host-side runtime state is excluded here.

# Exclude any stale tar artifacts that landed in the subdir
*.tar

# Exclude editor/IDE noise
.vscode/
.idea/
*.swp
*~

# Exclude git metadata (not needed in image layers)
.git/
